# Required for Gemini-powered features
GEMINI_API_KEY=AQ.Ab8RN6Kdhx8sgCjfd0eJik_S19S1Wb_NGhDW_uSgPG5Fw-hzlA

# Current stable Gemini model. Override if your account uses another supported model.
GEMINI_MODEL=gemini-3.8-flash

# Local explanation model from the project documentation.
EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
EXPLANATION_BACKEND=local

# Set to false to avoid loading the local Transformers model; /explain will use Gemini instead.
LOCAL_MODEL_ENABLED=true

# Server settings
HOST=127.0.0.1
PORT=8000

# Optional: allow browser access from other origins when embedding the API.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
